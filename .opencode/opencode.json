{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/AGENT.md"
  ],
  "permission": {
    "edit": "allow",
    "bash": {
      "git push *": "ask",
      "git commit *": "ask",
      "rm -rf *": "deny",
      "rm *": "ask",
      "composer require *": "ask",
      "npm install *": "ask",
      "*": "allow"
    },
    "external_directory": {
      "/var/folders/**": "allow",
      "*": "ask"
    }
  },
  "agent": {
    "reviewer": {
      "color": "#F39C12"
    }
  },
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",
      "options": {
        "baseURL": "http://160.250.135.47:20128/v1"
      },
      "models": {
        "deepseek-v4-pro": {
          "id": "cmc/deepseek/deepseek-v4-pro",
          "name": "DeepSeek V4 Pro"
        },
        "deepseek-v4-flash": {
          "id": "cmc/deepseek/deepseek-v4-flash",
          "name": "DeepSeek V4 Flash"
        },
        "gemini-2.5-pro": {
          "id": "gc/gemini-2.5-pro",
          "name": "Gemini 2.5 Pro"
        },
        "gpt-5.6-terra": {
          "id": "cx/gpt-5.6-terra",
          "name": "GPT 5.6 Terra"
        },
        "kimi-k2.6": {
          "id": "cmc/moonshotai/Kimi-K2.6",
          "name": "Kimi K2.6"
        },
        "gemini-3.8-flash-high": {
          "id": "ag/gemini-3.8-flash-high",
          "name": "Gemini 3.8 flash"
        }
      }
    }
  }
}