{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/AGENT.md"],

  "permission": {
    "edit": "allow",
    "bash": {
      "git push *": "ask",
      "git commit *": "ask",
      "rm -rf *": "deny",
      "rm *": "ask",
      "composer require *": "ask",
      "npm install *": "ask",
      "*": "allow"
    },
    "external_directory": {
      "/var/folders/**": "allow",
      "*": "ask"
    }
  },

  "agent": {
    "reviewer": {
      "color": "#F39C12"
    }
  }

}
