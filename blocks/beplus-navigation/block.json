{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "beplus-visual-mega-nav/beplus-navigation",
	"title": "BePlus Navigation",
	"category": "header",
	"parent": [ "beplus-visual-mega-nav/beplus-header", "core/group", "core/column" ],
	"icon": "menu",
	"description": "Flexible navigation container that hosts a classic menu and hamburger toggle.",
	"keywords": [ "navigation", "menu", "nav", "beplus" ],
	"textdomain": "beplus-visual-mega-nav",
	"attributes": {
		"overlayId": {
			"type": "string",
			"default": ""
		}
	},
	"usesContext": [
		"beplus-visual-mega-nav/instanceId",
		"beplus-visual-mega-nav/mobileBreakpoint"
	],
	"providesContext": {
		"beplus-visual-mega-nav/overlayId": "overlayId"
	},
	"supports": {
		"layout": {
			"type": "flex",
			"allowJustification": true,
			"allowVerticalAlignment": true
		},
		"spacing": {
			"blockGap": true,
			"padding": true
		}
	},
	"render": "file:./render.php",
	"style": "file:./style.css",
	"editorStyle": "file:./editor.css",
	"editorScript": "file:../../build/blocks.js"
}
