{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "beplus-visual-mega-nav/nav-toggle",
	"title": "Nav Toggle",
	"category": "header",
	"ancestor": [ "beplus-visual-mega-nav/beplus-header" ],
	"icon": "menu",
	"description": "Hamburger button that opens the mobile navigation overlay below the breakpoint.",
	"keywords": [ "hamburger", "toggle", "menu", "mobile", "beplus" ],
	"textdomain": "beplus-visual-mega-nav",
	"attributes": {
		"iconStyle": {
			"type": "string",
			"default": "lines-3"
		},
		"label": {
			"type": "string",
			"default": ""
		},
		"labelVisible": {
			"type": "boolean",
			"default": false
		}
	},
	"usesContext": [
		"beplus-visual-mega-nav/overlayId",
		"beplus-visual-mega-nav/instanceId",
		"beplus-visual-mega-nav/mobileBreakpoint"
	],
	"supports": {
		"html": false,
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"render": "file:./render.php",
	"style": "file:./style.css",
	"editorStyle": "file:./editor.css",
	"editorScript": "file:../../build/blocks.js"
}
