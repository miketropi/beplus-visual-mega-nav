{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "beplus-visual-mega-nav/product-card",
	"title": "Product Card",
	"category": "beplus-vmn",
	"icon": "cover-image",
	"description": "Display WooCommerce products in a card carousel with stacked deck animation. Swipe through products with smooth GSAP-powered transitions.",
	"keywords": [ "product", "woocommerce", "carousel", "card", "mega menu" ],
	"textdomain": "beplus-visual-mega-nav",
	"attributes": {
		"postsToShow": {
			"type": "number",
			"default": 6,
			"minimum": 3,
			"maximum": 20
		},
		"filterBy": {
			"type": "string",
			"default": "all"
		},
		"productCategories": {
			"type": "array",
			"default": []
		},
		"productTags": {
			"type": "array",
			"default": []
		},
		"productIds": {
			"type": "string",
			"default": ""
		},
		"showPrice": {
			"type": "boolean",
			"default": true
		},
		"showRating": {
			"type": "boolean",
			"default": false
		},
		"showAddToCart": {
			"type": "boolean",
			"default": true
		},
		"showTitle": {
			"type": "boolean",
			"default": true
		},
		"autoplay": {
			"type": "boolean",
			"default": false
		},
		"autoplayDelay": {
			"type": "number",
			"default": 3000
		},
		"cardWidth": {
			"type": "number",
			"default": 320,
			"minimum": 180
		},
		"imageRatio": {
			"type": "string",
			"default": "auto",
			"enum": [ "auto", "16-9", "4-3", "1-1" ]
		}
	},
	"supports": {
		"html": false,
		"anchor": false,
		"reusable": false,
		"multiple": true,
		"className": false,
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"style": "file:./style.css",
	"editorStyle": [ "file:./editor.css", "file:./style.css" ],
	"render": "file:./render.php",
	"editorScript": "file:../../build/blocks.js",
	"viewScript": "file:./view.js"
}
