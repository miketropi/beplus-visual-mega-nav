{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "beplus-visual-mega-nav/product-list",
	"title": "Product List",
	"category": "beplus-vmn",
	"icon": "cart",
	"description": "Display WooCommerce products with flexible filtering. Filter by category, tag, product IDs, featured products, or on-sale items.",
	"keywords": [ "product", "woocommerce", "shop", "list", "mega menu" ],
	"textdomain": "beplus-visual-mega-nav",
	"attributes": {
		"postsToShow": {
			"type": "number",
			"default": 4
		},
		"orderBy": {
			"type": "string",
			"default": "date"
		},
		"order": {
			"type": "string",
			"default": "DESC"
		},
		"filterBy": {
			"type": "string",
			"default": "all"
		},
		"productCategories": {
			"type": "array",
			"default": []
		},
		"productTags": {
			"type": "array",
			"default": []
		},
		"productIds": {
			"type": "string",
			"default": ""
		},
		"showImage": {
			"type": "boolean",
			"default": true
		},
		"showPrice": {
			"type": "boolean",
			"default": true
		},
		"showRating": {
			"type": "boolean",
			"default": false
		},
		"showAddToCart": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"anchor": false,
		"reusable": false,
		"multiple": true,
		"className": false,
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"style": "file:./style.css",
	"editorStyle": [ "file:./editor.css", "file:./style.css" ],
	"render": "file:./render.php",
	"editorScript": "file:../../build/blocks.js"
}
