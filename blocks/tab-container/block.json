{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "beplus-visual-mega-nav/tab-container",
	"title": "Tab Container",
	"category": "beplus-vmn",
	"description": "Organize mega menu content with tabs. Switch between vertical sidebar or horizontal top-nav layout.",
	"keywords": [ "tab", "tabs", "mega menu", "vertical tabs", "horizontal tabs" ],
	"textdomain": "beplus-visual-mega-nav",
	"icon": "table-row-after",
	"style": "file:./style.css",
	"editorStyle": [ "file:./editor.css", "file:./style.css" ],
	"render": "file:./render.php",
	"supports": {
		"html": false,
		"anchor": false,
		"reusable": false,
		"multiple": true,
		"className": false,
		"inserter": true,
		"align": [ "wide", "full" ]
	},
	"attributes": {
		"layoutMode": {
			"type": "string",
			"default": "vertical"
		},
		"indicatorColor": {
			"type": "string",
			"default": ""
		}
	}
}
