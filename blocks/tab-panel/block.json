{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "beplus-visual-mega-nav/tab-panel",
	"title": "Tab Panel",
	"category": "beplus-vmn",
	"parent": [ "beplus-visual-mega-nav/tab-container" ],
	"description": "A single tab panel for use inside the Tab Container block.",
	"keywords": [ "tab", "panel", "mega menu" ],
	"textdomain": "beplus-visual-mega-nav",
	"icon": "category",
	"style": "file:./style.css",
	"editorStyle": "file:./editor.css",
	"render": "file:./render.php",
	"editorScript": "file:../../build/blocks.js",
	"supports": {
		"html": false,
		"anchor": false,
		"reusable": false,
		"multiple": true,
		"className": false
	},
	"attributes": {
		"tabLabel": {
			"type": "string",
			"default": ""
		},
		"tabSubLabel": {
			"type": "string",
			"default": ""
		},
		"tabIcon": {
			"type": "string",
			"default": ""
		},
		"tabIconColor": {
			"type": "string",
			"default": ""
		}
	}
}
