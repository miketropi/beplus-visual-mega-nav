{
	"name": "snap/megamenu-builder",
	"description": "Gutenberg-powered mega menu builder for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"minimum-stability": "stable",
	"prefer-stable": true,
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"phpstan/phpstan": "^1.10",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"wp-coding-standards/wpcs": "^3.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"squizlabs/php_codesniffer": "^3.7",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-parallel-lint/php-parallel-lint": "^1.3",
		"yoast/phpunit-polyfills": "^2.0",
		"phpunit/phpunit": "^10.0"
	},
	"autoload": {
		"psr-4": {
			"Snap\\MegaMenuBuilder\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Snap\\MegaMenuBuilder\\Tests\\": "tests/php/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true,
		"optimize-autoloader": true
	},
	"scripts": {
		"lint:php": "parallel-lint --exclude vendor --exclude node_modules .",
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"phpstan": "phpstan analyse --memory-limit=1512M",
		"test:php": "phpunit --configuration phpunit.xml.dist",
		"check": [
			"@lint:php",
			"@phpcs",
			"@phpstan"
		]
	}
}
