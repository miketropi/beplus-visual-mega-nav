{
	"name": "snap-megamenu-builder",
	"version": "1.0.0",
	"description": "Gutenberg-powered mega menu builder for WordPress.",
	"private": true,
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js src/",
		"lint:css": "wp-scripts lint-style \"{src,blocks,assets}/**/*.css\"",
		"lint:js:fix": "wp-scripts lint-js src/ --fix",
		"lint:css:fix": "wp-scripts lint-style \"{src,blocks,assets}/**/*.css\" --fix",
		"format": "wp-scripts format src/",
		"check:js": "npm run lint:js && npm run lint:css",
		"test:js": "wp-scripts test-unit-js",
		"packages-update": "wp-scripts packages-update",
		"prepare": "husky",
		"zip": "npm run build && node scripts/build-zip.js",
		"test:wp": "bash scripts/wp-test.sh",
    "test:wp:reset": "bash scripts/wp-test.sh --reset"
	},
	"devDependencies": {
		"@wordpress/eslint-plugin": "^17.0.0",
		"@wordpress/scripts": "^27.0.0",
		"@wordpress/stylelint-config": "^22.0.0",
		"archiver": "^7.0.1",
		"husky": "^9.0.0",
		"lint-staged": "^15.0.0"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^6.0.0",
		"@wordpress/block-editor": "^12.0.0",
		"@wordpress/block-library": "^8.0.0",
		"@wordpress/blocks": "^12.0.0",
		"@wordpress/components": "^25.0.0",
		"@wordpress/compose": "^6.35.0",
		"@wordpress/element": "^5.0.0",
		"@wordpress/i18n": "^4.0.0",
		"@wordpress/icons": "^9.0.0",
		"@wordpress/keycodes": "^3.58.0"
	},
	"lint-staged": {
		"*.php": [
			"composer lint:php",
			"composer phpcs"
		],
		"src/**/*.{js,jsx}": [
			"wp-scripts lint-js --fix",
			"wp-scripts format"
		],
		"{src,blocks,assets}/**/*.css": [
			"wp-scripts lint-style --fix"
		]
	}
}
