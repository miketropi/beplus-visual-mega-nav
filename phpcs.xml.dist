<?xml version="1.0"?>
<ruleset name="Snap Mega Menu Builder">
	<description>WordPress coding standards for Snap Mega Menu Builder plugin.</description>

	<!-- Scan these files -->
	<file>snap-megamenu-builder.php</file>
	<file>includes/</file>
	<file>blocks/</file>

	<!-- Exclude -->
	<exclude-pattern>vendor/</exclude-pattern>
	<exclude-pattern>node_modules/</exclude-pattern>
	<exclude-pattern>build/</exclude-pattern>
	<exclude-pattern>tests/</exclude-pattern>
	<exclude-pattern>*.js</exclude-pattern>
	<exclude-pattern>*.css</exclude-pattern>

	<!-- Arguments -->
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg value="sp"/> <!-- show sniff codes + progress -->

	<!-- WordPress standards -->
	<rule ref="WordPress">
		<!-- Allow short array syntax -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<!-- Allow short ternary (sniff removed in WPCS 3.x) -->
	</rule>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<!-- PHP compatibility -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.0-"/>

	<!-- Text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="snap-megamenu-builder"/>
			</property>
		</properties>
	</rule>

	<!-- Minimum WP version -->
	<config name="minimum_wp_version" value="6.0"/>

	<!-- Prefixes -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="snap"/>
				<element value="Snap"/>
				<element value="SNAP"/>
			</property>
		</properties>
	</rule>
</ruleset>
